  <joint name="rear_right_caster_jt" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_caster"/>
    <origin xyz="-0.3529 -0.2030 -0.0675" rpy="0 0 0"/>
  </joint>

  <link name="lidar">
    <inertial>
      <origin xyz="-0.00056511 -1.4968E-05 0.019299" rpy="0 0 0"/>
      <mass value="0.16538"/>
      <inertia ixx="7.8866E-05" ixy="0" ixz="0"
               iyy="7.519E-05"  iyz="0" izz="0.00010995"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agv0509test6/meshes/Lidar.stl" />
