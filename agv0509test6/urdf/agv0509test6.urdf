    </collision>
  </link>

  <joint name="rear_left_caster_jt" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_caster"/>
    <origin xyz="-0.3529 0.1310 -0.0675" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0"
               iyy="1.5e-5" iyz="0" izz="1.5e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry>
